---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import badger from '../images/badger.svg';
---

<Base title="About" description="Who draws in this sketchbook, and why it's online.">
  <article class="wrap page">
    <header class="page__header">
      <p class="label">About</p>
      <h1>Hello, I'm Izzi.</h1>
    </header>
    <div class="about">
      <div class="prose">
        <p>
          By day I'm Ilze Koning: business analyst and solution architect. That side of me lives at
          <a href={SITE.ilzeKoning}>ilzekoning.com</a>, and it's tidy.
        </p>
        <p>
          This is the other side. Izzi Ink is my sketchbook: the doodles in the margins of a Moleskine, the drawings
          that get inked afterwards, the poems and essays I scribble when I should be doing something else, and
          design experiments I'm curious about.
        </p>
        <p>
          Some of the poems grew into a Kindle book, <a href={SITE.book.url}>{SITE.book.title}</a>.
        </p>
        <p>Nothing here has to be finished. That's rather the point.</p>
      </div>
      <figure class="card taped tilt badger">
        <img src={badger.src} width={badger.width} height={badger.height} alt="" />
        <figcaption class="hand">the original Izzi Ink mascot</figcaption>
      </figure>
    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: var(--space-6);
  }

  .page__header {
    margin-bottom: var(--space-5);
  }

  .about {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 40rem) {
    .about {
      grid-template-columns: 1fr 12rem;
    }
  }

  .badger {
    --tilt: 2deg;
    margin: 0;
    padding: var(--space-4) var(--space-3) var(--space-3);
    justify-self: center;
    max-width: 12rem;
  }

  figcaption {
    margin-top: var(--space-2);
    text-align: center;
  }
</style>
