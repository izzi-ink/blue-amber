---
import DrawingPage from '../../components/DrawingPage.astro';
import { getSketches } from '../../lib/entries';

export async function getStaticPaths() {
  const sketches = await getSketches('sketchbook');
  return sketches.map((sketch, i) => ({
    params: { slug: sketch.id },
    props: { sketch, newer: sketches[i - 1], older: sketches[i + 1] },
  }));
}
---

<DrawingPage {...Astro.props} />
