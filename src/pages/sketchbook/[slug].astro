---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/site';
import { getSketches } from '../../lib/entries';

export async function getStaticPaths() {
  const sketches = await getSketches();
  return sketches.map((sketch, i) => ({
    params: { slug: sketch.id },
    props: { sketch, newer: sketches[i - 1], older: sketches[i + 1] },
  }));
}

const { sketch, newer, older } = Astro.props;
const { Content } = await render(sketch);
const { data } = sketch;
const ogImage = await getImage({ src: data.image, width: 1200, format: 'jpeg' });
---

<Base title={data.title} description={data.description} type="article" image={ogImage.src}>
  <article class="wrap wrap--wide sketch">
    <header class="sketch__header">
      <p class="meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {data.medium && <span> · {data.medium}</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
    </header>

    {
      data.pencil ? (
        <div class="stages">
          <figure class="card taped tilt" style="--tilt: -1.5deg">
            <Image src={data.pencil} alt={data.pencilAlt ?? `Pencil sketch for ${data.title}`} widths={[480, 800]} sizes="(min-width: 50rem) 28rem, 90vw" />
            <figcaption class="hand">first, in pencil</figcaption>
          </figure>
          <span class="hand stages__arrow" aria-hidden="true">→</span>
          <figure class="card taped tilt" style="--tilt: 1deg">
            <Image src={data.image} alt={data.alt} widths={[480, 800, 1200]} sizes="(min-width: 50rem) 28rem, 90vw" />
            <figcaption class="hand">then, in ink</figcaption>
          </figure>
        </div>
      ) : (
        <figure class="card taped single">
          <Image src={data.image} alt={data.alt} widths={[480, 800, 1200]} sizes="(min-width: 46rem) 40rem, 90vw" />
        </figure>
      )
    }

    <div class="prose sketch__notes">
      <Content />
    </div>

    {
      data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))}
        </ul>
      )
    }

    <nav class="sketch__nav" aria-label="More drawings">
      {newer ? <a href={`/sketchbook/${newer.id}`}>← {newer.data.title}</a> : <span />}
      <a href="/sketchbook">All drawings</a>
      {older ? <a href={`/sketchbook/${older.id}`}>{older.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .sketch {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .sketch__header {
    display: grid;
    gap: var(--space-3);
    max-width: 46rem;
  }

  figure {
    margin: 0;
    padding: var(--space-3);
  }

  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  figcaption {
    margin-top: var(--space-2);
    text-align: center;
    font-size: var(--text-lg);
  }

  .single {
    max-width: 40rem;
    justify-self: center;
  }

  .stages {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding-top: var(--space-3);
  }

  .stages__arrow {
    font-size: 3rem;
    text-align: center;
    rotate: 90deg;
  }

  @media (min-width: 50rem) {
    .stages {
      grid-template-columns: 1fr auto 1fr;
    }

    .stages__arrow {
      rotate: 0deg;
    }
  }

  .sketch__notes {
    max-width: var(--measure);
  }

  .sketch__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
