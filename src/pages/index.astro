---
import Base from '../layouts/Base.astro';
import SketchGrid from '../components/SketchGrid.astro';
import NoteList from '../components/NoteList.astro';
import { SITE } from '../lib/site';
import { getNotes, getSketches } from '../lib/entries';

const sketches = (await getSketches('sketchbook')).slice(0, 6);
const paintings = (await getSketches('paintbox')).slice(0, 3);
const notes = (await getNotes()).slice(0, 3);
---

<Base>
  <section class="wrap wrap--wide hero">
    <p class="label">{SITE.tagline}</p>
    <h1>{SITE.name}</h1>
    <p class="lede">
      My sketchbook, out in the open. Drawings that start as pencil doodles in a Moleskine and get finished in ink,
      bits of writing, and design experiments that may or may not go anywhere.
    </p>
    <div class="buttons">
      <a class="button" href="/sketchbook">Open the sketchbook</a>
      <a class="button button--ghost" href="/notes">Read the notes</a>
    </div>
    <p class="hand hero__note" aria-hidden="true">mostly blue Bic, occasionally a pencil, never finished</p>
  </section>

  <section class="wrap wrap--wide section" aria-labelledby="latest">
    <div class="section__head">
      <p class="label">Sketchbook</p>
      <h2 id="latest">Latest doodles</h2>
    </div>
    <SketchGrid sketches={sketches} />
    <p class="more"><a href="/sketchbook">Every page →</a></p>
  </section>

  <section class="wrap wrap--wide section" aria-labelledby="paintbox">
    <div class="section__head">
      <p class="label">Paintbox</p>
      <h2 id="paintbox">Fresh from the paintbox</h2>
    </div>
    <SketchGrid sketches={paintings} />
    <p class="more"><a href="/paintbox">All the colour →</a></p>
  </section>

  <section class="wrap wrap--wide section" aria-labelledby="notes">
    <div class="section__head">
      <p class="label">Notes</p>
      <h2 id="notes">Thoughts, scribbled down</h2>
    </div>
    <NoteList notes={notes} />
    <p class="more"><a href="/notes">All notes →</a></p>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-7);
    padding-bottom: var(--space-5);
  }

  .hero h1 {
    font-size: var(--text-3xl);
    line-height: 1;
    rotate: -1.5deg;
    justify-self: start;
  }

  .hero .lede {
    max-width: 36rem;
  }

  .hero__note {
    font-size: var(--text-lg);
    rotate: -3deg;
    justify-self: start;
    margin-top: var(--space-2);
  }

  @media (min-width: 900px) {
    .hero__note {
      position: absolute;
      right: var(--space-3);
      top: calc(var(--space-7) + 3rem);
      max-width: 16rem;
      text-align: right;
      rotate: 4deg;
      margin-top: 0;
    }
  }

  .section {
    padding-top: var(--space-6);
  }

  .section__head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .more {
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
