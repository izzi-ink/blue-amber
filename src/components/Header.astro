---
import { NAV, SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../images/logo.svg';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="cover">
  <div class="wrap wrap--wide cover__inner">
    <a class="cover__name" href="/">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
      <span>{SITE.name}</span>
    </a>
    <div class="cover__actions">
      <nav aria-label="Main">
        <ul>
          {
            NAV.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* The black notebook cover */
  .cover {
    background: var(--cover);
    color: var(--cover-ink);
    border-bottom: 3px solid var(--paper-deep);
  }

  .cover__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
  }

  .cover__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* The name, written on the cover in white pen */
  .cover__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  /* The honey badger: the original Izzi Ink logo */
  .cover__name img {
    width: 2.25rem;
    height: auto;
  }

  .cover__name span {
    font-family: var(--font-hand);
    font-size: var(--text-xl);
    line-height: 1;
    rotate: -2deg;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 1.5px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: currentColor;
  }

  a:focus-visible {
    outline-color: var(--cover-ink);
  }
</style>
