---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap wrap--wide footer__inner">
    <ul class="footer__links">
      <li><a href={SITE.instagram}>Instagram</a></li>
      <li><a href={SITE.ilzeKoning}>Ilze Koning (the day job)</a></li>
      <li><a href={SITE.github}>GitHub</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="meta">© {year} Izzi Ink. Drawings and words are mine; please ask before reusing.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-5);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
