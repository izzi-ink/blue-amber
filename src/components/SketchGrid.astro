---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  sketches: CollectionEntry<'sketchbook'>[];
}

const { sketches } = Astro.props;
// A few angles to pin the cards at, so the wall looks hand-hung rather than gridded.
const tilts = ['-1.5deg', '1deg', '-0.5deg', '1.5deg', '-1deg', '0.5deg'];
---

<ul class="sketches">
  {
    sketches.map((sketch, i) => (
      <li class="card taped tilt" style={`--tilt: ${tilts[i % tilts.length]}`}>
        <a href={`/sketchbook/${sketch.id}`}>
          <Image
            src={sketch.data.image}
            alt={sketch.data.alt}
            widths={[360, 560, 800]}
            sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 45vw, 90vw"
          />
          <span class="hand sketch__title">{sketch.data.title}</span>
        </a>
        {sketch.data.pencil && <span class="label sketch__flag">pencil → ink</span>}
      </li>
    ))
  }
</ul>

<style>
  .sketches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-6) var(--space-5);
    list-style: none;
    margin: 0;
    padding: var(--space-3) 0 0;
  }

  li {
    padding: var(--space-3) var(--space-3) var(--space-2);
  }

  a {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 2px;
  }

  .sketch__title {
    font-size: var(--text-lg);
    text-align: center;
  }

  .sketch__flag {
    position: absolute;
    right: var(--space-3);
    top: var(--space-4);
    background: var(--card);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
</style>
